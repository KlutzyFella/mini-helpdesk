{
  "info": {
    "name": "Mini Helpdesk",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'user-' + Math.random().toString(36).slice(2, 12) + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test('token saved', function () { var j = pm.response.json(); pm.expect(j.data.token).to.be.a('string'); pm.collectionVariables.set('userToken', j.data.token); });",
                  "pm.test('no passwordHash', function () { pm.expect(pm.response.text()).to.not.include('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register (duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('success is false', function () { pm.expect(pm.response.json().success).to.eql(false); });",
                  "pm.test('error.code is EMAIL_TAKEN', function () { pm.expect(pm.response.json().error.code).to.eql('EMAIL_TAKEN'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (wrong password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('success is false', function () { pm.expect(pm.response.json().success).to.eql(false); });",
                  "pm.test('error.code is INVALID_CREDENTIALS', function () { pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test('admin token saved', function () { var j = pm.response.json(); pm.expect(j.data.user.role).to.eql('ADMIN'); pm.collectionVariables.set('adminToken', j.data.token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (user)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test('role is USER', function () { pm.expect(pm.response.json().data.role).to.eql('USER'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('success is true', function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test('role is ADMIN', function () { pm.expect(pm.response.json().data.role).to.eql('ADMIN'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
